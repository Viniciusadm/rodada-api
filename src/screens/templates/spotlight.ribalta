@title Destaque
@theme editorial
@color success #1f8a5b
@color danger #d1343a

@extern status = question
@extern round = 3
@extern has_timer = true
@extern seconds_left = 18
@extern question = "Qual é o maior oceano do planeta?"
@extern revealed = false
@extern answer = "Oceano Pacífico"
@extern was_correct = true
@extern player = "Ana"
@extern points_earned = 100
@extern headline = "Aguardando início"
@extern winner = ""

@data example_options
| text      | correct |
| ---       | ---     |
| Atlântico | false   |
| Pacífico  | true    |
| Índico    | false   |
| Ártico    | false   |
@end
@extern options = $example_options

@style choice {size=xl weight=semibold pad="xs md" radius=md}
@style right-choice {bg=success color=white}
@style dimmed {opacity=0.3}

--- {cover=false}
::: if $status == question
::: stack {gap=lg align=center}
::: row {gap=lg align=center valign=center}
Pergunta $round {.kicker}
$seconds_left {size=4xl weight=black color=accent if="$has_timer"}
:::
# $question {align=center size=5xl leading=tight shrink=2xl}
::: row {gap=lg align=center wrap if="len($options) > 0"}
::: for option, i in $options
[$i. $option.text]{.choice .right-choice="$revealed and $option.correct" .dimmed="$revealed and not $option.correct"}
:::
:::
$answer {size=3xl weight=bold color=success if="$revealed and len($options) == 0"}
:::
:::
::: else if $status == result
::: stack {gap=sm align=center}
Certo! {size=7xl weight=black color=success if="$was_correct"}
Não foi dessa vez {size=5xl weight=black color=danger if="not $was_correct"}
$player {size=3xl weight=bold}
+$points_earned pontos {size=2xl .muted if="$points_earned > 0"}
:::
:::
::: else
::: stack {gap=md align=center}
# $headline {size=6xl align=center}
$winner venceu! {size=4xl weight=bold color=accent if="$winner != ''"}
:::
:::
