@title Telão da partida
@theme ink
@color certo #23976a
@color errado #e5484d
@color opcao-a #e11d48
@color opcao-b #0284c7
@color opcao-c #f59e0b
@color opcao-d #059669

@extern partida = "Quiz da juventude"
@extern situacao = pergunta
@extern rodada = 3
@extern cronometro = true
@extern tempo = 18
@extern pergunta = "Qual é o maior oceano do planeta?"
@extern revelada = false
@extern resposta = "Oceano Pacífico"
@extern aviso = "Os jogadores respondem pelo celular"
@extern acertou = true
@extern jogador = "Ana"
@extern ganhos = 100
@extern titulo = "Aguardando início"
@extern vencedor = ""
@extern mostrar_placar = true

@data exemplo_opcoes
| texto     | correta |
| ---       | ---     |
| Atlântico | false   |
| Pacífico  | true    |
| Índico    | false   |
| Ártico    | false   |
@end
@extern opcoes = $exemplo_opcoes

@data exemplo_placar
| nome  | pontos | fora  |
| ---   | ---    | ---   |
| Ana   | 300    | false |
| Bruno | 200    | false |
| Carla | 100    | false |
@end
@extern placar = $exemplo_placar

@style opcao {bg=surface radius=lg pad="sm lg" size=xl weight=bold color=white align=center}
@style cor-a {bg=opcao-a}
@style cor-b {bg=opcao-b}
@style cor-c {bg=opcao-c}
@style cor-d {bg=opcao-d}
@style apagada {opacity=0.35}
@style escolhida {border="6 white"}
@style linha {bg=surface radius=md pad="sm md"}
@style eliminado {opacity=0.45}

@component palco
::: if $situacao == pergunta
::: stack {gap=sm align=center}
::: row {gap=lg valign=center}
Pergunta $rodada {.kicker}
$tempo s {size=xl weight=black color=accent if="$cronometro"}
:::
## $pergunta {align=center}
::: grid {cols=2 gap=md w=100%}
::: for opcao, i in $opcoes
::: box {.opcao .cor-a="$i % 4 == 1" .cor-b="$i % 4 == 2" .cor-c="$i % 4 == 3" .cor-d="$i % 4 == 0" .apagada="$revelada and not $opcao.correta" .escolhida="$revelada and $opcao.correta"}
$opcao.texto
:::
:::
:::
$resposta {size=2xl weight=bold color=certo if="$revelada and len($opcoes) == 0"}
$aviso {.muted size=lg}
:::
:::
::: else if $situacao == resultado
::: stack {gap=md align=center}
::: box {.card align=center gap=sm pad="lg xl" bg=certo/20 if="$acertou"}
✓ Acertou! {size=5xl weight=black color=certo}
$jogador {size=2xl weight=bold}
+$ganhos pts {size=xl weight=bold if="$ganhos > 0"}
:::
::: box {.card align=center gap=sm pad="lg xl" bg=errado/20 if="not $acertou"}
✗ Errou {size=5xl weight=black color=errado}
$jogador {size=2xl weight=bold}
:::
Aguardando próxima pergunta {.muted size=2xl}
:::
:::
::: else
::: stack {gap=md align=center}
🏆 {size=7xl}
# $titulo
Vencedor: $vencedor {size=3xl weight=bold color=accent if="$vencedor != ''"}
:::
:::
@end

@header
::: row {gap=md valign=center}
Rodada {.kicker}
$partida {size=lg weight=bold}
:::
@end

--- {cover=false}
::: if $mostrar_placar
::: columns {widths="3 1" gap=xl valign=center}
:: palco
::: stack {gap=sm}
### Placar
::: for pessoa, i in $placar
::: columns {.linha .eliminado=$pessoa.fora widths="3 1" gap=sm valign=center}
::: row {gap=sm valign=center}
$i. {weight=bold color=muted}
$pessoa.nome {weight=bold}
Fora {size=sm weight=bold color=errado if="$pessoa.fora"}
:::
::: stack {align=right}
$pessoa.pontos {weight=black}
:::
:::
:::
:::
:::
:::
::: else
:: palco
:::
