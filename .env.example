DATABASE_URL=mysql://holyplay:holyplay@127.0.0.1:3306/holyplay
JWT_SECRET=replace-with-a-long-random-secret
RUN_MIGRATIONS=true
# The required game catalog (games + modes) is always seeded on startup.
# DEMO_SEEDS controls ONLY the optional demo/filler data (sample org/admin,
# players, question bank, a finished match and notifications).
DEMO_SEEDS=false
# Only used when DEMO_SEEDS=true.
DEMO_ADMIN_EMAIL=admin@holyplay.local
DEMO_ADMIN_PASSWORD=holyplay-demo-admin
RUST_LOG=info
